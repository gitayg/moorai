{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "/opt/moorai/bin/moorai-agent-hook copilot",
        "timeoutSec": 30
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "/opt/moorai/bin/moorai-agent-hook copilot",
        "timeoutSec": 30
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "/opt/moorai/bin/moorai-agent-hook copilot",
        "timeoutSec": 30
      }
    ]
  }
}
