{
  "description": "MoorAI on-device guardrails: the same PreToolUse, PostToolUse, UserPromptSubmit, PostToolUseFailure, Stop, SubagentStop and PreCompact hooks `node cli/moorai-hook.mjs install` writes into ~/.claude/settings.json. test/plugin-manifest.test.mjs keeps the two in step.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/cli/moorai-hook.mjs\" --plugin"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/cli/moorai-hook.mjs\" --plugin"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/cli/moorai-hook.mjs\" --plugin"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/cli/moorai-hook.mjs\" --plugin"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/cli/moorai-hook.mjs\" --plugin"
