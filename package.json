{
  "name": "moorai",
  "version": "1.4.2",
  "license": "MIT",
  "description": "MoorAI agent — AI security at the point. Runtime guardrails for AI agents, apps and APIs (community edition, MIT)",
  "type": "module",
  "exports": {
    ".": "./scan.mjs",
    "./scan": "./scan.mjs"
  },
  "bin": {
    "moorai-aibom": "cli/moorai-aibom.mjs",
    "moorai-guard": "cli/moorai-guard.mjs",
    "moorai-hook": "cli/moorai-hook.mjs",
    "moorai-ledger": "cli/moorai-ledger.mjs",
    "moorai-redteam": "cli/moorai-redteam.mjs",
    "moorai-agentwatch": "cli/moorai-agentwatch.mjs",
    "moorai-destinations": "cli/moorai-destinations.mjs",
    "moorai-trace": "cli/moorai-trace.mjs",
    "moorai-shadow": "cli/moorai-shadow.mjs",
    "moorai-compliance": "cli/moorai-compliance.mjs",
    "moorai-verify-chain": "cli/moorai-verify-chain.mjs",
    "moorai-stix": "cli/moorai-stix.mjs",
    "moorai-honeytokens": "cli/moorai-honeytokens.mjs",
    "moorai-attest": "cli/moorai-attest.mjs",
    "moorai-receipt": "cli/moorai-receipt.mjs",
    "moorai-scan": "cli/moorai-scan.mjs",
    "moorai-agent-hook": "cli/moorai-agent-hook.mjs",
    "moorai-doctor": "cli/moorai-doctor.mjs",
    "moorai-explain": "cli/moorai-explain.mjs",
    "moorai-serve": "cli/moorai-serve.mjs",
    "moorai-mcp-gateway": "mcp-gateway/moorai-mcp-gateway.mjs",
    "moorai-model-proxy": "model-proxy/moorai-model-proxy.mjs",
    "moorai-cloud-inventory": "cloud/moorai-cloud-inventory.mjs"
  },
  "files": [
    "scan.mjs",
    "cli/",
    "src/",
    "data/",
    "scripts/redteam.mjs",
    "scripts/accepted-failures.mjs",
    "test/redteam/corpus.json",
    "mcp-gateway/",
    "model-proxy/",
    "mcp-proxy/tool-scan.mjs",
    "mcp-proxy/tool-baseline.mjs",
    "cloud/",
    "packages/agent-sdk/src/"
  ],
  "scripts": {
    "client": "python3 -m http.server 8000",
    "guard": "node cli/moorai-guard.mjs",
    "hook": "node cli/moorai-hook.mjs",
    "aibom": "node cli/moorai-aibom.mjs",
    "scan": "node cli/moorai-scan.mjs",
    "ledger": "node cli/moorai-ledger.mjs",
    "destinations": "node cli/moorai-destinations.mjs",
    "tauri": "tauri",
    "redteam": "node scripts/redteam.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "redteam-policy": "node cli/moorai-redteam.mjs",
    "agentwatch": "node cli/moorai-agentwatch.mjs",
    "hooktest": "node scripts/hooktest.mjs",
    "redteam-eval": "node scripts/redteam-eval.mjs",
    "validate-blocking": "node scripts/moorai-validate-blocking.mjs",
    "release": "node scripts/release.mjs",
    "test": "npm run test:harnesses && npm run test:generated && npm run test:scorers && npm run test:unit",
    "test:harnesses": "node scripts/hooktest.mjs && node cli/verify-gateway.mjs && node browser-ext/test-detectors.mjs && node mcp-proxy/test-proxy.mjs && node scripts/redteam.mjs && node scripts/moorai-validate-blocking.mjs && node scripts/moorai-validate-blocking.mjs --mode offline",
    "test:generated": "node scripts/benchmark.mjs && git diff --exit-code -I generatedAt -I '^> Generated:' -- docs/BENCHMARK.md docs/benchmark.json && git checkout -- docs/BENCHMARK.md docs/benchmark.json",
    "test:scorers": "node scripts/redteam-eval.mjs --fail-under 96 && node scripts/score-benign-v2.mjs --fail-over 4",
    "test:unit": "node --test --test-concurrency=4 --import ./test/hermetic-env.mjs test/*.test.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tauri-apps/cli": "^2"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  }
}
