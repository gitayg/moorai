{
  "name": "moorai",
  "version": "0.45.0",
  "description": "MoorAI agent — on-device guardrails for AI coding agents (community edition, AGPL-3.0)",
  "type": "module",
  "bin": {
    "moorai-aibom": "cli/moorai-aibom.mjs",
    "moorai-guard": "cli/moorai-guard.mjs",
    "moorai-hook": "cli/moorai-hook.mjs",
    "moorai-ledger": "cli/moorai-ledger.mjs",
    "moorai-redteam": "cli/moorai-redteam.mjs",
    "moorai-agentwatch": "cli/moorai-agentwatch.mjs"
  },
  "files": [
    "cli/",
    "src/",
    "data/",
    "scripts/redteam.mjs",
    "test/redteam/corpus.json"
  ],
  "scripts": {
    "client": "python3 -m http.server 8000",
    "guard": "node cli/moorai-guard.mjs",
    "hook": "node cli/moorai-hook.mjs",
    "aibom": "node cli/moorai-aibom.mjs",
    "ledger": "node cli/moorai-ledger.mjs",
    "tauri": "tauri",
    "redteam": "node scripts/redteam.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "redteam-policy": "node cli/moorai-redteam.mjs",
    "agentwatch": "node cli/moorai-agentwatch.mjs",
    "hooktest": "node scripts/hooktest.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  }
}
