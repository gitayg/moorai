    "node": ">=20"
  },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "prepack": "node scripts/vendor.mjs",
    "postpack": "node scripts/vendor.mjs --clean"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "*"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
