# rpmbuild spec for the MoorAI agent, generated by scripts/build-linux-package.mjs (@VERSION@ is filled in).
# Build from the tarball next to it:
#   rpmbuild -bb moorai.spec --define "_sourcedir $PWD"
Name:           moorai
Version:        @VERSION@
Release:        1
Summary:        MoorAI agent: runtime guardrails for AI coding agents
License:        MIT
URL:            https://github.com/gitayg/moorai
Source0:        moorai-@VERSION@-linux.tar.gz
BuildArch:      noarch
Recommends:     nodejs >= 18

%description
The MoorAI agent for Linux: the moorai-* command-line tools, the hooks for AI coding agents and the
detection engine, with systemd user units to register the hooks at login and to run the engine sidecar.
Reports are content-free.

%prep
%setup -q -n moorai-@VERSION@

%build

%install
mkdir -p %{buildroot}
cp -a root/usr %{buildroot}/
mkdir -p %{buildroot}/etc/moorai

%post
sh /usr/lib/moorai/linux/moorai-node --check || echo "MoorAI: the hooks need Node.js 18 or newer." >&2
echo "MoorAI installed. Register the hooks per user with: moorai-install-hooks"

%preun
if [ "$1" = 0 ] && command -v systemctl >/dev/null 2>&1; then
  systemctl --global disable moorai-hooks.service moorai-serve.service >/dev/null 2>&1 || true
fi

%files
%dir /etc/moorai
/usr/lib/moorai
/usr/bin/moorai-*
/usr/lib/systemd/user/moorai-hooks.service
/usr/lib/systemd/user/moorai-serve.service
